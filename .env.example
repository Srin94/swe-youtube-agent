# Google AI Studio Free API Key (PRIMARY provider — native structured output)
GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------------
# Multi-provider LLM fallback (src/llm_providers.py)
# ---------------------------------------------------------------------------
# When Gemini is overloaded (503 "high demand") or hits its daily quota (429),
# generation automatically falls back across these free, OpenAI-compatible
# providers in LLM_PROVIDER_ORDER. Set as many keys as you like — providers
# without a key are skipped, so Gemini-only still works exactly as before.
# Order of providers to try. gemini_native = Gemini via google-genai (strict
# schema). The rest are OpenAI-SDK-compatible.
LLM_PROVIDER_ORDER=gemini_native,groq,openrouter
# Truncate the article fed to the OpenAI-compat providers so Groq's free
# tokens-per-minute limit never trips (Gemini native gets the full article).
LLM_MAX_INPUT_CHARS=8000

# Groq Cloud — console.groq.com  (openai/gpt-oss-120b on the free tier)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter — openrouter.ai/settings/keys  (use a :free model id)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Telegram HITL Approval Bot (Optional locally, recommended for CI)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_CHAT_ID=987654321
# How long to wait for your Approve/Cancel tap before giving up.
APPROVAL_WINDOW_MINUTES=120
# Fail-closed: no tap within the window => NOT published. Set true to restore
# the old behaviour where silence auto-publishes after the timeout.
APPROVE_ON_TIMEOUT=false

# YouTube Data API v3 OAuth2 Credentials
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token

# Background Music (soothing bed mixed under the narration)
# Default: a fresh procedurally-generated ambient track every render (zero
# assets, never the same twice). Drop royalty-free files in
# agent-backend/assets/music/ to use those instead.
BACKGROUND_MUSIC_ENABLED=true
# Bed loudness in dBFS; lower is quieter. Narration sits near -16..-20.
MUSIC_LEVEL_DBFS=-30
MUSIC_FADE_MS=2500

# Local Testing Flags
DRY_RUN_SKIP_UPLOAD=false
