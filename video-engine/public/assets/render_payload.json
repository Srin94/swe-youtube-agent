    {
      "scene_id": 4,
      "chapter_title": "The Fix",
      "visual_type": "CodeDiff",
      "narration_text": "The fix was a two line change: cache validation results and fail open on a stale cert instead of hard rejecting every single handshake.",
      "camera_focus_node_id": null,
      "hud": {
        "context_label": "INCIDENT CLOCK",
        "context_value": "T+00:28:00",
        "status_text": "RECOVERING",
        "status_level": "info",
        "stats": [
          {
            "label": "RPS",
            "value": "4.6M/s",
            "emphasis": "normal"
          },
          {
            "label": "p99",
            "value": "180ms",
            "emphasis": "warning"
          },
          {
            "label": "ERROR",
            "value": "3.2%",
            "emphasis": "warning"
          }
        ],
        "insight": "Fail Open vs Security Risk"
      },
      "nodes": [],
      "edges": [],
      "code_diff": {
        "language": "go",
        "filename": "edge/tls_validate.go",
        "before_code": "func validate(cert *Cert) error {\n    if cert.Expired() {\n        return ErrReject\n    }\n    return callValidator(cert)\n}",
        "after_code": "func validate(cert *Cert) error {\n    if v, ok := cache.Get(cert.ID); ok {\n        return v\n    }\n    if cert.Expired() {\n        return nil // fail open, log + alert\n    }\n    return cache.SetAndReturn(cert.ID, callValidator(cert))\n}",
        "highlight_explanation": "Cache + fail-open kills the retry storm"
      },
      "benchmarks": [],
      "timeline_events": [],
      "callout_keywords": [
        "cache",
        "fail",
        "open"
      ],
      "start_sec": 27.82,
      "duration_sec": 9.23
    },
